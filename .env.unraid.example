# Frappe LMS - unRAID Environment Variables
# Copy this to .env and customize as needed for your unRAID deployment

# Database Configuration
# Root password for MariaDB - CHANGE THIS IN PRODUCTION
MYSQL_ROOT_PASSWORD=frappe123

# Site Configuration
# Name of the Frappe site to create/use
SITE_NAME=lms.localhost

# Administrator password for the Frappe application
ADMIN_PASSWORD=narlicwes0

# Database Host
# Service name from docker-compose (lms-db container)
DB_HOST=lms-db

# Redis Configuration
# Cache database (DB 0)
REDIS_CACHE=lms-redis:6379/0

# Queue database (DB 1)
REDIS_QUEUE=lms-redis:6379/1

# Socket.IO database (DB 2)
REDIS_SOCKETIO=lms-redis:6379/2
